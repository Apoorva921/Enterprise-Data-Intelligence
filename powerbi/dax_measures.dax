// ============================================================================
// Enterprise Real-Time Data Intelligence Platform - DAX Measures Library
// Author: Lead Data Architect
// Model: Star Schema (Fact_Orders, Dim_Customers, Dim_Products, Dim_Dates)
// ============================================================================

// ----------------------------------------------------------------------------
// 1. REVENUE & FINANCIAL MEASURES
// ----------------------------------------------------------------------------

[Total Gross Revenue] := 
SUM(fact_orders[total_amount])

[Net Revenue] := 
SUMX(
    fact_orders,
    fact_orders[total_amount] - fact_orders[tax_amount] - fact_orders[shipping_fee]
)

[Total Orders] := 
DISTINCTCOUNT(fact_orders[order_id])

[Completed Orders] := 
CALCULATE(
    [Total Orders],
    fact_orders[status] = "COMPLETED"
)

[Cancelled Orders] := 
CALCULATE(
    [Total Orders],
    fact_orders[status] = "CANCELLED"
)

[Refunded Orders] := 
CALCULATE(
    [Total Orders],
    fact_orders[status] = "REFUNDED"
)

[Average Order Value (AOV)] := 
DIVIDE([Total Gross Revenue], [Total Orders], 0)

[Total Cost of Goods Sold (COGS)] := 
SUMX(
    fact_order_items,
    fact_order_items[total_cost]
)

[Gross Profit] := 
[Total Gross Revenue] - [Total Cost of Goods Sold (COGS)]

[Gross Margin %] := 
DIVIDE([Gross Profit], [Total Gross Revenue], 0) * 100

// ----------------------------------------------------------------------------
// 2. TIME INTELLIGENCE MEASURES (MoM, YoY)
// ----------------------------------------------------------------------------

[Revenue MTD] := 
TOTALMTD([Total Gross Revenue], dim_dates[full_date])

[Revenue Prior Month] := 
CALCULATE(
    [Total Gross Revenue],
    DATEADD(dim_dates[full_date], -1, MONTH)
)

[Revenue MoM Growth %] := 
VAR CurrentRev = [Total Gross Revenue]
VAR PriorRev = [Revenue Prior Month]
RETURN
DIVIDE(CurrentRev - PriorRev, PriorRev, 0) * 100

[Revenue YoY Growth %] := 
VAR CurrentRev = [Total Gross Revenue]
VAR LastYearRev = CALCULATE([Total Gross Revenue], SAMEPERIODLASTYEAR(dim_dates[full_date]))
RETURN
DIVIDE(CurrentRev - LastYearRev, LastYearRev, 0) * 100

// ----------------------------------------------------------------------------
// 3. CUSTOMER ANALYTICS & RETENTION
// ----------------------------------------------------------------------------

[Total Active Customers] := 
DISTINCTCOUNT(fact_orders[customer_id])

[Repeat Customers Count] := 
COUNTROWS(
    FILTER(
        VALUES(fact_orders[customer_id]),
        CALCULATE([Total Orders]) > 1
    )
)

[Repeat Purchase Rate %] := 
DIVIDE([Repeat Customers Count], [Total Active Customers], 0) * 100

[Customer Lifetime Value (CLV)] := 
DIVIDE([Total Gross Revenue], [Total Active Customers], 0)

// ----------------------------------------------------------------------------
// 4. PAYMENT & TRANSACTION SUCCESS MEASURES
// ----------------------------------------------------------------------------

[Total Payments] := 
COUNTROWS(fact_payments)

[Successful Payments] := 
CALCULATE(
    [Total Payments],
    fact_payments[is_successful] = TRUE()
)

[Failed Payments] := 
CALCULATE(
    [Total Payments],
    fact_payments[is_successful] = FALSE()
)

[Payment Success Rate %] := 
DIVIDE([Successful Payments], [Total Payments], 0) * 100

[Payment Failure Rate %] := 
DIVIDE([Failed Payments], [Total Payments], 0) * 100

// ----------------------------------------------------------------------------
// 5. REGIONAL & CATEGORY CONTRIBUTION
// ----------------------------------------------------------------------------

[Regional Revenue Share %] := 
DIVIDE(
    [Total Gross Revenue],
    CALCULATE([Total Gross Revenue], ALL(fact_orders[shipping_region])),
    0
) * 100


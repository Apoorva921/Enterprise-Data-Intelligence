# Environment Configuration for Enterprise Data Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Security
SECRET_KEY=enterprise-secret-key-change-in-production-3af41cdc
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Database Connections
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_SCHEMA=public

# MongoDB Connection
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ecommerce_events
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongopassword

# Object Lake Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ecommerce-lake
S3_REGION=us-east-1
STORAGE_BACKEND=local # 'local' for filesystem/duckdb, 'minio' or 's3'

# Kafka Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_PAYMENTS=payments
KAFKA_TOPIC_EVENTS=customer_events
KAFKA_TOPIC_INVENTORY=inventory_updates
KAFKA_TOPIC_DLQ=dead_letter_queue
KAFKA_CONSUMER_GROUP=ecommerce_data_platform

# Airflow
AIRFLOW_WEBSERVER_PORT=8080

# Prometheus & Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# FastAPI & React
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
